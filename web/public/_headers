# Cloudflare Pages custom headers
# Global security headers for all paths
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# HTML documents: must revalidate so clients receive new deployments immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static Vite hashed assets: safe for long-term immutable caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon asset caching
/favicon*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

