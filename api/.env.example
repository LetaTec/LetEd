# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# SQLite database file (relative to the api/ folder or absolute)
DATABASE_PATH=./data/leta-ed.sqlite

# Public origin of the website. Used to reject cross-site writes and to
# build password-reset links. Required in production.
WEB_ORIGIN=http://localhost:5173

# Session lifetime in days (default and "remember me")
SESSION_TTL_DAYS=1
SESSION_REMEMBER_TTL_DAYS=30

# How password-reset emails are delivered.
#   console - writes the reset link to the API log (development only)
#   (unset) - password recovery responds with PASSWORD_RECOVERY_UNAVAILABLE
# A real email provider must be wired in before launch (see README).
MAIL_TRANSPORT=console

# Serve the built website (web/dist) from the API in production
SERVE_WEB_DIST=false
